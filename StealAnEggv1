local MIN_INCOME_THRESHOLD = 1000000
local EggPool = {}
local ClaimedEggs = {}
local AutoStealEnabled = false
local AutoThread = nil

local CurrentTarget = {
    Uid = "",
    SlotKey = "",
    AreaId = "Forest",
    Name = "Scanning...",
    Rarity = "None",
    Income = "+0/s",
    AssetId = LoadedIcon,
    Instance = nil
}

local function ParseIncomeNumber(str)
    if not str then return 0 end
    local text = tostring(str):upper():gsub(",", "")
    local numStr = text:match("[%d%.]+")
    if not numStr then return 0 end
    local num = tonumber(numStr) or 0
    
    if text:find("T") then num = num * 1e12
    elseif text:find("B") then num = num * 1e9
    elseif text:find("M") then num = num * 1e6
    elseif text:find("K") then num = num * 1e3 end
    
    return num
end

local function ScanPhysicalEggs()
    local detected = {}
    for _, desc in pairs(Workspace:GetDescendants()) do
        if desc:IsA("PVInstance") or desc:IsA("Folder") or desc:IsA("Configuration") then
            local uid = desc:GetAttribute("Uid") or desc:GetAttribute("UID")
            local slotKey = desc:GetAttribute("FirstAreaSlotKey") or desc:GetAttribute("SlotKey") or desc.Name
            local category = desc:GetAttribute("AssetCategory") or desc:GetAttribute("Name")
            local income = desc:GetAttribute("MoneyPerSec") or desc:GetAttribute("Income")
            local rarity = desc:GetAttribute("Rarity")
            local areaId = desc:GetAttribute("AreaId") or slotKey:split(":")[1] or "Forest"
            
            if not uid and (desc.Name:find("Egg_") or desc.Name:find("Slot_")) then
                uid = desc.Name
            end

            if uid and not ClaimedEggs[tostring(uid)] then
                table.insert(detected, {
                    Uid = tostring(uid),
                    FirstAreaSlotKey = tostring(slotKey),
                    AreaId = tostring(areaId),
                    AssetCategory = tostring(category or desc.Name),
                    Rarity = tostring(rarity or "Rare"),
                    MoneyPerSec = tostring(income or "+0/s"),
                    AssetId = LoadedIcon,
                    Instance = desc:IsA("PVInstance") and desc or desc.Parent
                })
            end
        end
    end
    return detected
end

local function EvaluateRarestEgg()
    local rawList = {}
    for _, egg in ipairs(EggPool) do table.insert(rawList, egg) end
    for _, egg in ipairs(ScanPhysicalEggs()) do table.insert(rawList, egg) end
    
    local candidates = {}
    local seenUids = {}
    
    for _, egg in ipairs(rawList) do
        local uid = egg.Uid or egg.UID or ""
        if uid ~= "" and not ClaimedEggs[uid] and not seenUids[uid] then
            seenUids[uid] = true
            local incomeVal = ParseIncomeNumber(egg.MoneyPerSec or egg.Income)
            if incomeVal >= MIN_INCOME_THRESHOLD then
                egg.ParsedIncome = incomeVal
                table.insert(candidates, egg)
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.ParsedIncome > b.ParsedIncome
    end)

    if #candidates > 0 then
        local top = candidates[1]
        CurrentTarget.Uid = top.Uid or top.UID or ""
        CurrentTarget.SlotKey = top.FirstAreaSlotKey or top.SlotKey or ""
        CurrentTarget.AreaId = top.AreaId or (CurrentTarget.SlotKey:split(":")[1] or "Forest")
        CurrentTarget.Name = top.AssetCategory or top.Name or "Burrowing Owl"
        CurrentTarget.Rarity = top.Rarity or "Rare"
        CurrentTarget.Income = top.MoneyPerSec or top.Income or "+1M/s"
        CurrentTarget.AssetId = FetchImage(top.AssetId) ~= "" and FetchImage(top.AssetId) or LoadedIcon
        CurrentTarget.Instance = top.Instance
        return true
    end

    CurrentTarget.Uid = ""
    CurrentTarget.Name = "No Eggs >= $1M"
    CurrentTarget.Rarity = "None"
    CurrentTarget.Income = "+0/s"
    CurrentTarget.AssetId = LoadedIcon
    CurrentTarget.Instance = nil
    return false
end

