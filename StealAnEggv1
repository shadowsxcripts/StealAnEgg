-- Workspace Deep Scanner
local function DeepScanWorkspace()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local uid = obj:GetAttribute("Uid") or obj:GetAttribute("UID")
            if not uid and obj:FindFirstChild("Uid") then uid = obj.Uid.Value end
            
            local isEgg = false
            local incomeText = "+$10,000/s"
            
            for _, desc in ipairs(obj:GetDescendants()) do
                if desc:IsA("TextLabel") and (string.find(desc.Text, "%$") or string.find(desc.Text, "/s")) then
                    isEgg = true
                    incomeText = desc.Text
                    break
                end
            end
            
            if isEgg and not uid then uid = obj.Name .. "_" .. tostring(math.floor(obj:GetPivot().Position.Magnitude)) end
            local slotKey = obj:GetAttribute("SlotKey") or obj:GetAttribute("FirstAreaSlotKey") or "Forest:Slot_001"
            
            if isEgg and uid and not HubState.ProcessedUids[uid] then
                local rawMoney = ParseIncomeString(incomeText)
                table.insert(HubState.ActiveEggs, {
                    Uid = uid,
                    SlotKey = slotKey,
                    AssetCategory = obj.Name,
                    AreaId = "Forest",
                    IncomeFormatted = incomeText,
                    IncomeVal = rawMoney > 0 and rawMoney or 15000
                })
                HubState.ProcessedUids[uid] = true
            end
        end
    end
    RefreshHUD()
end

-- Network Interceptor for RaritiesShown
if RaritiesShownEvent then
    RaritiesShownEvent.OnClientEvent:Connect(function(payload)
        if payload and payload.RareSpawns then
            for _, spawn in ipairs(payload.RareSpawns) do
                local uid = spawn.Uid or spawn.UID
                if uid and not HubState.ProcessedUids[uid] then
                    local incomeTxt = spawn.IncomeRate or "+$50,000/s"
                    table.insert(HubState.ActiveEggs, {
                        Uid = uid,
                        SlotKey = spawn.SlotKey or "Forest:Slot_002",
                        AssetCategory = spawn.AssetCategory or "Mythic Egg",
                        AreaId = spawn.AreaId or "Forest",
                        IncomeFormatted = incomeTxt,
                        IncomeVal = ParseIncomeString(incomeTxt)
                    })
                    HubState.ProcessedUids[uid] = true
                end
            end
            RefreshHUD()
        end
    end)
end

