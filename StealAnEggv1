local function FireClientSignal(signal, ...)
    if typeof(firesignal) == "function" then
        pcall(firesignal, signal, ...)
    elseif typeof(getconnections) == "function" then
        for _, connection in ipairs(getconnections(signal)) do
            if connection.Function then
                task.spawn(connection.Function, ...)
            end
        end
    end
end

local function RandomizedLatencyWait(minMs, maxMs)
    task.wait(math.random(minMs or 100, maxMs or 250) / 1000)
end

local function HumanoidJitterMove(targetCFrame)
    if not LocalPlayer.Character then return end
    local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character.PrimaryPart
    if not rootPart then return end
    local jitterX = math.random(-5, 5) / 10
    local jitterZ = math.random(-5, 5) / 10
    local tween = TweenService:Create(rootPart, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {CFrame = targetCFrame + Vector3.new(jitterX, 0, jitterZ)})
    tween:Play()
    tween.Completed:Wait()
end

local function ParseIncomeString(str)
    if not str then return 0 end
    if type(str) == "number" then return str end
    local clean = tostring(str):upper()
    local numPart = tonumber(string.match(clean, "[%d%.]+")) or 1
    local sfx = string.match(clean, "[KMBTQAISXPO]+$") or ""
    local mult = {K=1e3, M=1e6, B=1e9, T=1e12, QA=1e15, QI=1e18, SX=1e21, SP=1e24, OC=1e27, NO=1e30}
    return numPart * (mult[sfx] or 1)
end

