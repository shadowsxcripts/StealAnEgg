-- Cross-Executor Signal Helper
local function FireClientSignal(signal, ...)
    if typeof(firesignal) == "function" then
        firesignal(signal, ...)
    elseif typeof(getconnections) == "function" then
        for _, connection in ipairs(getconnections(signal)) do
            if connection.Function then
                task.spawn(connection.Function, ...)
            end
        end
    end
end

-- Helper to convert formatted strings (e.g., "+1.5M") into real numbers for flawless sorting
local function ParseIncomeString(val)
    if type(val) == "number" then return val end
    if not val then return 0 end
    
    local cleanStr = tostring(val):upper():gsub("[+%s$,]", "")
    local multiplier = 1
    
    if string.find(cleanStr, "K") then multiplier = 1e3; cleanStr = string.gsub(cleanStr, "K", "")
    elseif string.find(cleanStr, "M") then multiplier = 1e6; cleanStr = string.gsub(cleanStr, "M", "")
    elseif string.find(cleanStr, "B") then multiplier = 1e9; cleanStr = string.gsub(cleanStr, "B", "")
    elseif string.find(cleanStr, "T") then multiplier = 1e12; cleanStr = string.gsub(cleanStr, "T", "")
    end
    
    local num = tonumber(cleanStr) or 0
    return num * multiplier
end

