-- Cross-Executor Signal Dispatcher
local function FireClientSignal(signal, ...)
    if typeof(firesignal) == "function" then
        pcall(firesignal, signal, ...)
    elseif typeof(getconnections) == "function" then
        for _, connection in ipairs(getconnections(signal)) do
            if connection.Function then
                task.spawn(connection.Function, ...)
            end
        end
    end
end

-- Randomized Network Latency Wrapper (Human-like ping variation)
local function RandomizedLatencyWait(minMs, maxMs)
    minMs = minMs or 120
    maxMs = maxMs or 380
    local delaySeconds = math.random(minMs, maxMs) / 1000
    task.wait(delaySeconds)
end

-- Jitter-Based Movement & Position Simulation
local function HumanoidJitterMove(targetCFrame)
    if not LocalPlayer.Character then return end
    local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character.PrimaryPart
    if not rootPart then return end
    
    -- Add human micro-jitter offset (±0.6 studs) to avoid linear robotic pathing
    local jitterX = math.random(-6, 6) / 10
    local jitterZ = math.random(-6, 6) / 10
    local jitteredCFrame = targetCFrame + Vector3.new(jitterX, 0, jitterZ)
    
    local tweenDuration = math.random(18, 35) / 100
    local tweenInfo = TweenInfo.new(tweenDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = jitteredCFrame})
    tween:Play()
    tween.Completed:Wait()
end

-- Bulletproof Income String Parser ($49M, 1.5Qa, etc.)
local function ParseIncomeString(str)
    if not str or type(str) == "number" then return tonumber(str) or 0 end
    local cleanStr = tostring(str):upper()
    local numStr = string.match(cleanStr, "[%d%.]+") or "0"
    local suffix = string.match(cleanStr, "[A-Z]+") or ""
    local num = tonumber(numStr) or 0
    local multipliers = {
        K = 1e3, M = 1e6, B = 1e9, T = 1e12,
        QA = 1e15, QI = 1e18, SX = 1e21, SP = 1e24,
        OC = 1e27, NO = 1e30, DC = 1e33, UN = 1e36
    }
    return num * (multipliers[suffix] or 1)
end

