--------------------------------------------------------------------------------
-- CARD UPDATE & PURE MONEY SORTING LOGIC
--------------------------------------------------------------------------------
local function RefreshHUD()
    -- Sort active eggs STRICTLY by highest money per second
    table.sort(HubState.ActiveEggs, function(a, b)
        return (a.IncomeVal or 0) > (b.IncomeVal or 0)
    end)

    -- Target the highest paying egg
    if #HubState.ActiveEggs > 0 then
        local top = HubState.ActiveEggs[1]
        HubState.CurrentTarget = top
        
        NameLabel.Text = top.AssetCategory or "Unknown Egg"
        
        if top.Rarity == "Eternal" then
            RarityLabel.TextColor3 = Color3.fromRGB(255, 0, 128)
        elseif top.Rarity == "Divine" then
            RarityLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
        else
            RarityLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        
        RarityLabel.Text = "Rarity: " .. (top.Rarity or "Unknown")
        MoneyLabel.Text = (top.IncomeFormatted or "+$0") .. " / sec"
        EggImage.Image = top.IconAsset or "rbxassetid://6031075931"
        StealBtn.Text = "STEAL HIGHEST PAYING"
    else
        HubState.CurrentTarget = nil
        NameLabel.Text = "No Eggs Available"
        RarityLabel.Text = "Rarity: N/A"
        RarityLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        MoneyLabel.Text = "$0 / sec"
        EggImage.Image = "rbxassetid://0"
        StealBtn.Text = "NO TARGET DETECTED"
    end
end

-- Core Steal Execution
local function StealCurrentTarget()
    if not HubState.CurrentTarget then return end
    local target = HubState.CurrentTarget

    if not HubState.BaseCFrame and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        HubState.BaseCFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
    end

    if AskCarryFunction then
        pcall(function()
            AskCarryFunction:InvokeServer({
                FirstAreaSlotKey = target.SlotKey,
                Uid = target.Uid
            })
        end)
    end

    if CarryEvent then
        FireClientSignal(CarryEvent.OnClientEvent, {
            SpeedMultiplier = 0.95,
            Uid = target.Uid,
            GuardDisabled = true,
            RunBackWakeDelayRequired = false,
            AssetCategory = target.AssetCategory,
            IsCarrying = true,
            AreaId = target.AreaId
        })
    end

    -- Remove stolen egg and instantly shift to the next highest paying egg
    HubState.ProcessedUids[target.Uid] = true
    for i, egg in ipairs(HubState.ActiveEggs) do
        if egg.Uid == target.Uid then
            table.remove(HubState.ActiveEggs, i)
            break
        end
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and HubState.BaseCFrame then
        task.wait(0.2)
        LocalPlayer.Character.HumanoidRootPart.CFrame = HubState.BaseCFrame
    end

    RefreshHUD()
end

StealBtn.MouseButton1Click:Connect(function()
    StealCurrentTarget()
end)

--------------------------------------------------------------------------------
-- SERVER BROADCAST DETECTOR
--------------------------------------------------------------------------------
if RaritiesShownEvent then
    RaritiesShownEvent.OnClientEvent:Connect(function(payload)
        if payload and payload.RareSpawns then
            for _, spawn in ipairs(payload.RareSpawns) do
                local uid = spawn.Uid or spawn.UID
                if uid and not HubState.ProcessedUids[uid] then
                    
                    -- Calculate true numeric value for accurate money-sorting
                    local rawMoney = spawn.RawIncome or ParseIncomeString(spawn.IncomeRate)

                    table.insert(HubState.ActiveEggs, {
                        Uid = uid,
                        SlotKey = spawn.SlotKey or spawn.FirstAreaSlotKey or "",
                        AssetCategory = spawn.AssetCategory or spawn.Name or "Rare Egg",
                        AreaId = spawn.AreaId or spawn.Area or "Unknown",
                        Rarity = spawn.Rarity or "Secret",
                        IncomeFormatted = spawn.IncomeRate or ("+$" .. tostring(rawMoney)),
                        IncomeVal = rawMoney, -- Used for the pure sorting logic
                        IconAsset = spawn.Icon or spawn.ImageAsset or "rbxassetid://6031075931"
                    })
                end
            end
            RefreshHUD()
        end
    end)
end
