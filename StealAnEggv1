-- Rarest Egg Server Scanner & Automatic Queue Rotation
local function ScanServerEggs()
    local searchRoots = {Workspace}
    for _, root in ipairs(searchRoots) do
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("Folder") then
                local uid = obj:GetAttribute("Uid") or obj:GetAttribute("UID")
                local assetCat = obj:GetAttribute("AssetCategory") or obj:GetAttribute("EggName")
                local incomeRate = obj:GetAttribute("IncomeRate") or obj:GetAttribute("MoneyPerSecond")
                
                if assetCat and not HubState.ProcessedUids[uid or obj.Name] then
                    local realUid = uid or (obj.Name .. "_" .. math.floor(obj:GetPivot().Position.Magnitude))
                    table.insert(HubState.ActiveEggs, {
                        Uid = realUid,
                        SlotKey = obj:GetAttribute("SlotKey") or "Cosmic:Slot_001",
                        AssetCategory = assetCat,
                        IncomeFormatted = tostring(incomeRate or "+$100,000,000/s"),
                        IncomeVal = tonumber(incomeRate) or 100000000,
                        AreaId = obj:GetAttribute("AreaId") or "Cosmic"
                    })
                    HubState.ProcessedUids[realUid] = true
                end
            end
        end
    end

    -- Sort by highest money per second (Rarest/Best first)
    table.sort(HubState.ActiveEggs, function(a, b)
        return (a.IncomeVal or 0) > (b.IncomeVal or 0)
    end)

    if #HubState.ActiveEggs > 0 then
        HubState.CurrentTarget = HubState.ActiveEggs[1]
        NameLabel.Text = HubState.CurrentTarget.AssetCategory
        MoneyLabel.Text = HubState.CurrentTarget.IncomeFormatted
    else
        HubState.CurrentTarget = nil
        NameLabel.Text = "Scanning Server..."
        MoneyLabel.Text = "$0 / sec"
    end
end

task.spawn(function()
    while true do
        pcall(ScanServerEggs)
        task.wait(2)
    end
end)

