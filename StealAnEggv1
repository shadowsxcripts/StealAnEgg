local function FireClientSignal(signal, ...)
    if typeof(firesignal) == "function" then
        firesignal(signal, ...)
    elseif typeof(getconnections) == "function" then
        for _, connection in ipairs(getconnections(signal)) do
            if connection.Function then
                task.spawn(connection.Function, ...)
            end
        end
    end
end

--------------------------------------------------------------------------------
-- PREMIUM BYPASS: DEEP DATA EXTRACTION (NO STRING PARSING)
--------------------------------------------------------------------------------
local function GetTrueEggValue(eggModel)
    -- 1. Direct Attribute Read (Fastest, most accurate)
    local attributes = {"RawIncome", "Income", "CoinValue", "BaseValue", "Money"}
    for _, attr in ipairs(attributes) do
        local val = eggModel:GetAttribute(attr)
        if type(val) == "number" then return val end
    end

    -- 2. Internal Value Object Read
    for _, obj in ipairs(eggModel:GetDescendants()) do
        if (obj:IsA("NumberValue") or obj:IsA("IntValue")) and table.find(attributes, obj.Name) then
            return obj.Value
        end
    end

    -- 3. Rarity Override (If numbers are completely hidden server-side)
    local rarity = eggModel:GetAttribute("Rarity")
    if rarity == "Eternal" then return 9e35
    elseif rarity == "Divine" then return 9e34
    elseif rarity == "Secret" then return 9e33
    end

    -- 4. Pure Number Extraction from any text (Fallback, strips all letters)
    for _, desc in ipairs(eggModel:GetDescendants()) do
        if desc:IsA("TextLabel") and string.find(desc.Text, "%$") then
            -- Extracts only the raw digits, ignoring everything else
            local pureNumber = string.match(desc.Text, "%d+%.?%d*")
            if pureNumber then
                return tonumber(pureNumber) or 0
            end
        end
    end

    return 0
end

