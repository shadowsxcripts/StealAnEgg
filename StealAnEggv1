-- Steal Execution Function with Jitter & Latency Wrappers
local function ExecuteHumanizedSteal(target)
    if not target then return end

    FooterLabel.Text = "Jitter Steal: " .. target.AssetCategory
    
    -- Simulate randomized human network latency before invoking server
    RandomizedLatencyWait(150, 450)

    -- 1. Ask Server to Carry with Randomized Latency
    if AskCarryFunction then
        pcall(function()
            AskCarryFunction:InvokeServer({
                FirstAreaSlotKey = target.SlotKey or "Forest:Slot_002",
                Uid = target.Uid
            })
        end)
    end

    RandomizedLatencyWait(80, 200)

    -- 2. Fire Client Signal with Jittered Movement
    if CarryEvent then
        FireClientSignal(CarryEvent.OnClientEvent, {
            SpeedMultiplier = 0.95044861554791,
            Uid = target.Uid,
            GuardDisabled = false,
            RunBackWakeDelayRequired = true,
            AssetCategory = target.AssetCategory,
            IsCarrying = true,
            AreaId = target.AreaId or "Forest"
        })
    end

    HubState.TotalStolen = HubState.TotalStolen + 1

    -- Remove from queue
    for i, egg in ipairs(HubState.ActiveEggs) do
        if egg.Uid == target.Uid then
            table.remove(HubState.ActiveEggs, i)
            break
        end
    end

    -- Humanized return movement with Jitter CFrame simulation
    task.wait(0.1)
    if LocalPlayer.Character and HubState.BaseCFrame then
        HumanoidJitterMove(HubState.BaseCFrame)
    end

    RefreshHUD()
end

