-- Core Workflow: Forest -> Boss Hit -> Rarest Area -> Collect -> Boss Ride -> Safe Zone -> Queue Rotation
local function ExecuteWorkflow(target)
    if not target then return end
    print("[Shadow Hub]: Starting Forest Boss Hit & Rarest Area Sequence for:", target.AssetCategory)

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart

    -- Step 1: Go to Forest
    root.CFrame = CFrame.new(0, 10, 0)
    task.wait(0.6)

    -- Step 2: Forest Boss Hit Trigger
    print("[Shadow Hub]: Waiting for Forest boss hit trigger...")
    task.wait(0.8)

    -- Step 3: Teleport to rarest egg area
    print("[Shadow Hub]: Teleporting to rarest egg area:", target.AreaId)
    root.CFrame = CFrame.new(150, 10, 150)
    task.wait(0.4)

    -- Step 4: Collect rare egg via remote
    if AskCarryFunction then
        pcall(function()
            AskCarryFunction:InvokeServer({
                FirstAreaSlotKey = target.SlotKey or "Cosmic:Slot_001",
                Uid = target.Uid
            })
        end)
    end

    -- Step 5: Boss chase riding on top -> Safe Zone delivery
    print("[Shadow Hub]: Boss chasing! Staying on top of boss until Safe Zone...")
    task.wait(1)
    
    -- Simulate riding on top of boss towards safe zone
    local boss = Workspace:FindFirstChild("Boss") or Workspace:FindFirstChild("ForestBoss")
    if boss and boss.PrimaryPart then
        root.CFrame = boss.PrimaryPart.CFrame + Vector3.new(0, 8, 0)
    end
    task.wait(0.8)

    root.CFrame = CFrame.new(500, 10, 500) -- Safe Zone
    print("[Shadow Hub]: Successfully delivered to Safe Zone!")

    HubState.TotalStolen = HubState.TotalStolen + 1

    -- Automatic Queue Rotation: Remove collected egg and shift to 2nd best egg
    for i, egg in ipairs(HubState.ActiveEggs) do
        if egg.Uid == target.Uid then
            table.remove(HubState.ActiveEggs, i)
            break
        end
    end

    print("[Shadow Hub]: Queue rotated. Switched to next rarest egg.")
end

