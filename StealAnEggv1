local function ParseIncome(str)
    if not str then return 0 end
    if type(str) == "number" then return str end
    local clean = tostring(str):upper()
    local numPart = tonumber(string.match(clean, "[%d%.]+")) or 1
    local sfx = string.match(clean, "[KMBTQAISXPO]+$") or ""
    local mult = {K=1e3, M=1e6, B=1e9, T=1e12, QA=1e15, QI=1e18, SX=1e21, SP=1e24, OC=1e27, NO=1e30}
    return numPart * (mult[sfx] or 1)
end

local function RefreshHUD()
    table.sort(HubState.ActiveEggs, function(a, b)
        return (a.IncomeVal or 0) > (b.IncomeVal or 0)
    end)

    if #HubState.ActiveEggs > 0 then
        HubState.CurrentTarget = HubState.ActiveEggs[1]
        NameLabel.Text = HubState.CurrentTarget.AssetCategory
        MoneyLabel.Text = HubState.CurrentTarget.IncomeFormatted
        RarityBadge.Text = HubState.CurrentTarget.Rarity or "MYTHIC"
    else
        HubState.CurrentTarget = nil
        NameLabel.Text = "No Eggs Found"
        MoneyLabel.Text = "$0 / sec"
        RarityBadge.Text = "NONE"
    end
end

-- Diagnostic Scanner with Attribute Logging
local function DiagnosticScanner()
    local searchRoots = {
        Workspace:FindFirstChild("Eggs"),
        Workspace:FindFirstChild("FieldEggs"),
        Workspace:FindFirstChild("ActiveEggs"),
        Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Eggs")
    }

    for _, folder in ipairs(searchRoots) do
        if folder then
            for _, obj in ipairs(folder:GetChildren()) do
                if obj:IsA("Model") or obj:IsA("Folder") then
                    local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    local trans = primary and primary.Transparency or 0
                    local mat = primary and tostring(primary.Material) or "SmoothPlastic"
                    local col = primary and string.format("R:%.2f G:%.2f B:%.2f", primary.Color.R, primary.Color.G, primary.Color.B) or "N/A"
                    local uid = tostring(obj:GetAttribute("Uid") or obj.Name)

                    local isSolid = true
                    if trans >= 0.1 then isSolid = false end

                    print(string.format("[Shadow Diagnostics]: Name: %s | Uid: %s | Trans: %.2f | Mat: %s | Color: %s | Solid: %s", 
                        obj.Name, uid, trans, mat, col, tostring(isSolid)))

                    if isSolid then
                        local detectedRarity = "RARE"
                        local incomeRate = "+$50,000/s"
                        if mat:find("Neon") or mat:find("Glass") then
                            detectedRarity = "LEGENDARY"
                            incomeRate = "+$500,000/s"
                        end

                        local areaId = obj:GetAttribute("AreaId") or "Forest"
                        if not SlotKeyRegistry[areaId] then areaId = "Forest" end
                        local slotKey = obj:GetAttribute("SlotKey") or SlotKeyRegistry[areaId].ValidSlots[1]

                        if not HubState.ProcessedUids[uid] then
                            table.insert(HubState.ActiveEggs, {
                                Uid = uid,
                                SlotKey = tostring(slotKey),
                                AssetCategory = obj.Name,
                                IncomeFormatted = incomeRate,
                                IncomeVal = ParseIncome(incomeRate),
                                AreaId = tostring(areaId),
                                Rarity = detectedRarity,
                                Transparency = trans,
                                Material = mat,
                                ColorInfo = col,
                                InstanceRef = obj
                            })
                            HubState.ProcessedUids[uid] = true
                        end
                    end
                end
            end
        end
    end
    RefreshHUD()
end

task.spawn(function()
    while true do
