--------------------------------------------------------------------------------
-- UTILITY & DRAG SYSTEM (No Deprecated Functions)
--------------------------------------------------------------------------------

local function MakeDraggable(Frame, DragHandle)
    local Dragging, DragInput, DragStart, StartPos
    DragHandle = DragHandle or Frame

    DragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            DragStart = input.Position
            StartPos = Frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    Dragging = false
                end
            end)
        end
    end)

    Frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            DragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == DragInput and Dragging then
            local Delta = input.Position - DragStart
            TweenService:Create(Frame, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + Delta.X, StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y)
            }):Play()
        end
    end)
end

local function GetHRP()
    local Char = LocalPlayer.Character
    if not Char then return nil end
    return Char:FindFirstChild("HumanoidRootPart")
end

--------------------------------------------------------------------------------
-- EGG QUEUE LOGIC (Automatic Fallback to 2nd Best Egg)
--------------------------------------------------------------------------------

local function EvaluateQueue()
    if #RareEggList == 0 then return false end

    for _, eggData in ipairs(RareEggList) do
        local uid = eggData.Uid or eggData.UID or ""
        if uid ~= "" and not ClaimedEggs[uid] then
            CurrentTarget.Uid = uid
            CurrentTarget.SlotKey = eggData.FirstAreaSlotKey or eggData.SlotKey or ""
            CurrentTarget.AreaId = eggData.AreaId or eggData.Area or (CurrentTarget.SlotKey:split(":")[1] or "")
            CurrentTarget.Name = eggData.AssetCategory or eggData.Name or "Unknown Egg"
            CurrentTarget.Rarity = eggData.Rarity or "Rare"
            CurrentTarget.Income = eggData.MoneyPerSec or eggData.Income or "+150/s"
            CurrentTarget.AssetId = eggData.AssetId or eggData.Image or "rbxassetid://1789465698045"
            return true
        end
    end

    CurrentTarget.Uid = ""
    CurrentTarget.Name = "No Eggs Available"
    CurrentTarget.Rarity = "None"
    CurrentTarget.Income = "+0/s"
    return false
end

