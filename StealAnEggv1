            pcall(function() ExecuteAdvancedSteal(HubState.CurrentTarget) end)
        end
    end
end)

local function DeepInspectorScanner()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local uid = obj:GetAttribute("Uid") or obj:GetAttribute("UID") or obj:GetAttribute("ID")
            local realName = obj:GetAttribute("EggName") or obj:GetAttribute("AssetCategory") or obj:GetAttribute("DisplayName")
            local incomeRate = obj:GetAttribute("IncomeRate") or obj:GetAttribute("MoneyPerSecond")
            local iconVal = obj:GetAttribute("Icon") or obj:GetAttribute("ImageAsset")

            local foundText = ""
            local foundImage = iconVal and ("rbxassetid://" .. tostring(iconVal)) or ""

            for _, desc in ipairs(obj:GetDescendants()) do
                if desc:IsA("TextLabel") then
                    local t = desc.Text or ""
                    if string.find(t, "%$") or string.find(t, "/s") then
                        foundText = t
                    elseif not realName and string.len(t) > 2 and not string.find(t, "Level") and not string.find(t, "%$") then
                        realName = t
                    end
                elseif desc:IsA("ImageLabel") then
                    local img = desc.Image or ""
                    if img ~= "" and not string.find(img, "0") then
                        foundImage = img
                    end
                end
            end

            if foundText ~= "" or realName or uid then
                if not uid then
                    uid = obj.Name .. "_" .. tostring(math.floor(obj:GetPivot().Position.Magnitude))
                end
                if not realName or string.match(realName, "^[%w_]+$") and string.len(realName) > 12 then
                    realName = obj.Name ~= "" and obj.Name or "Field Egg"
                end

                local formattedMoney = foundText ~= "" and foundText or "+$25,000/s"
                local rawValue = ParseRealIncome(formattedMoney)

                if not HubState.ProcessedUids[uid] and rawValue >= 0 then
                    table.insert(HubState.ActiveEggs, {
                        Uid = uid,
                        SlotKey = obj:GetAttribute("SlotKey") or "Forest:Slot_001",
                        AssetCategory = realName,
                        AreaId = obj:GetAttribute("AreaId") or "Forest",
                        IncomeFormatted = formattedMoney,
                        IncomeVal = rawValue > 0 and rawValue or 10000,
                        IconAsset = foundImage ~= "" and foundImage or "rbxassetid://6031075931"
                    })
                    HubState.ProcessedUids[uid] = true
                end
            end
        end
    end
    RefreshHUD()
end

