    if HubState.AutoSteal then
        StealBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50) -- Turns Red
        StealBtn.Text = "AUTO GET: ON"
        
        -- Lock in your Base Position the moment you turn it on
        if not HubState.BaseCFrame and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            HubState.BaseCFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
        end
    else
        StealBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100) -- Turns Green
        StealBtn.Text = "AUTO GET: OFF"
    end
end)

-- The Auto-Steal Loop
task.spawn(function()
    while task.wait(0.5) do
        if HubState.AutoSteal and HubState.CurrentTarget then
            StealCurrentTarget()
        end
    end
end)

