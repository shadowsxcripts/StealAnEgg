--------------------------------------------------------------------------------
-- DEEP MAP SCANNER
--------------------------------------------------------------------------------
local function ScanServerForEggs()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local uid = obj:GetAttribute("Uid") or obj:GetAttribute("UID")
            local slotKey = obj:GetAttribute("SlotKey") or obj:GetAttribute("FirstAreaSlotKey")
            
            if not uid and obj:FindFirstChild("Uid") then uid = obj.Uid.Value end
            if not slotKey and obj:FindFirstChild("SlotKey") then slotKey = obj.SlotKey.Value end
            
            if uid and slotKey and not HubState.ProcessedUids[uid] then
                
                -- Route through the new Deep Data extractor
                local rawMoney = GetTrueEggValue(obj)
                
                if rawMoney > 0 then
                    table.insert(HubState.ActiveEggs, {
                        Uid = uid,
                        SlotKey = slotKey,
                        AssetCategory = obj.Name,
                        AreaId = "Map",
                        IncomeVal = rawMoney,
                        IconAsset = "rbxassetid://6031075931"
                    })
                    HubState.ProcessedUids[uid] = true
                end
            end
        end
    end
    RefreshHUD()
end

task.spawn(function()
    while task.wait(2) do
        ScanServerForEggs()
    end
end)

--------------------------------------------------------------------------------
-- NETWORK INTERCEPTOR (Instant spawn detection)
--------------------------------------------------------------------------------
if RaritiesShownEvent then
    RaritiesShownEvent.OnClientEvent:Connect(function(payload)
        if payload and payload.RareSpawns then
            for _, spawn in ipairs(payload.RareSpawns) do
                local uid = spawn.Uid or spawn.UID
                if uid and not HubState.ProcessedUids[uid] then
                    
                    -- Prioritize real network integers over everything
                    local rawMoney = spawn.RawIncome or spawn.Income or 0
                    
                    if rawMoney == 0 then
                        if spawn.Rarity == "Eternal" then rawMoney = 9e35
                        elseif spawn.Rarity == "Divine" then rawMoney = 9e34
                        elseif spawn.Rarity == "Secret" then rawMoney = 9e33 end
                    end
                    
                    table.insert(HubState.ActiveEggs, {
                        Uid = uid, 
                        SlotKey = spawn.SlotKey or spawn.FirstAreaSlotKey or "",
                        AssetCategory = spawn.AssetCategory or spawn.Name or "Target", 
                        AreaId = spawn.AreaId or spawn.Area or "Unknown",
                        IncomeVal = rawMoney, 
                        IconAsset = spawn.Icon or spawn.ImageAsset or "rbxassetid://6031075931"
                    })
                    HubState.ProcessedUids[uid] = true
                end
            end
            RefreshHUD()
        end
    end)
end

ScanServerForEggs()
