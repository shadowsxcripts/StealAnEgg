--------------------------------------------------------------------------------
ToggleBg.MouseButton1Click:Connect(function()
    HubState.AutoSteal = not HubState.AutoSteal
    
    local knobGoal = {}
    local bgGoal = {}

    if HubState.AutoSteal then
        knobGoal.Position = UDim2.new(1, -24, 0.5, -11)
        bgGoal.BackgroundColor3 = Color3.fromRGB(40, 200, 80) -- Green like the image
        ToggleText.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        -- Lock Base Position
        if not HubState.BaseCFrame and LocalPlayer.Character and LocalPlayer.Character.PrimaryPart then
            HubState.BaseCFrame = LocalPlayer.Character.PrimaryPart.CFrame
        end
    else
        knobGoal.Position = UDim2.new(0, 2, 0.5, -11)
        bgGoal.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        ToggleText.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
    
    -- Smooth Animations
    TweenService:Create(ToggleKnob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), knobGoal):Play()
    TweenService:Create(ToggleBg, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), bgGoal):Play()
end)

local function StealCurrentTarget()
    if not HubState.CurrentTarget then return end
    local target = HubState.CurrentTarget

    -- INSTANT Server Steal Call
    if AskCarryFunction then
        task.spawn(function()
            pcall(function() AskCarryFunction:InvokeServer({FirstAreaSlotKey = target.SlotKey, Uid = target.Uid}) end)
        end)
    end

    -- INSTANT Client Visual Bypass
    if CarryEvent then
        FireClientSignal(CarryEvent.OnClientEvent, {
            SpeedMultiplier = 1, Uid = target.Uid, GuardDisabled = true,
            RunBackWakeDelayRequired = false, AssetCategory = target.AssetCategory,
            IsCarrying = true, AreaId = target.AreaId
        })
    end

    -- Remove from queue
    for i, egg in ipairs(HubState.ActiveEggs) do
        if egg.Uid == target.Uid then
            table.remove(HubState.ActiveEggs, i)
            break
        end
    end

    -- Clean Teleport back to safe zone
    if LocalPlayer.Character and HubState.BaseCFrame then
        LocalPlayer.Character:PivotTo(HubState.BaseCFrame)
    end

    RefreshHUD()
end

task.spawn(function()
    while task.wait(0.1) do
        if HubState.AutoSteal and HubState.CurrentTarget then
            StealCurrentTarget()
        end
    end
end)

--------------------------------------------------------------------------------
-- AGGRESSIVE HYBRID SCANNER (Fixes "No Eggs Available")
--------------------------------------------------------------------------------
local function ScanServerForEggs()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            -- Fallback system: if attributes are missing, force read its name
            local uid = obj:GetAttribute("Uid") or obj:GetAttribute("UID")
            if not uid and obj:FindFirstChild("Uid") then uid = obj.Uid.Value end
            
            -- If it has a BillboardGui with money text, it's definitely an egg
            local isEgg = false
            local incomeText = "+$0/s"
            
            for _, desc in ipairs(obj:GetDescendants()) do
                if desc:IsA("TextLabel") and (string.find(desc.Text, "%$") or string.find(desc.Text, "/s")) then
                    isEgg = true
                    incomeText = desc.Text
                    break
                end
            end
            
            -- Force UID assignment if we know it's an egg but it's hidden
            if isEgg and not uid then uid = obj.Name end 
            local slotKey = obj:GetAttribute("SlotKey") or obj:GetAttribute("FirstAreaSlotKey") or ""
            
            if isEgg and uid and not HubState.ProcessedUids[uid] then
                local rawMoney = ParseIncomeString(incomeText)
                
                table.insert(HubState.ActiveEggs, {
                    Uid = uid,
                    SlotKey = slotKey,
                    AssetCategory = obj.Name,
                    AreaId = "Map",
                    IncomeFormatted = incomeText,
                    IncomeVal = rawMoney,
                    IconAsset = "rbxassetid://6031075931"
                })
                HubState.ProcessedUids[uid] = true
            end
        end
    end
    RefreshHUD()
end

task.spawn(function()
    while task.wait(2) do
        ScanServerForEggs()
    end
end)

--------------------------------------------------------------------------------
-- NETWORK INTERCEPTOR
--------------------------------------------------------------------------------
if RaritiesShownEvent then
    RaritiesShownEvent.OnClientEvent:Connect(function(payload)
        if payload and payload.RareSpawns then
            for _, spawn in ipairs(payload.RareSpawns) do
                local uid = spawn.Uid or spawn.UID
                if uid and not HubState.ProcessedUids[uid] then
                    local incomeTxt = spawn.IncomeRate or "+$0/s"
                    local rawMoney = ParseIncomeString(incomeTxt)
                    
                    table.insert(HubState.ActiveEggs, {
                        Uid = uid, 
                        SlotKey = spawn.SlotKey or spawn.FirstAreaSlotKey or "",
                        AssetCategory = spawn.AssetCategory or spawn.Name or "Target", 
                        AreaId = spawn.AreaId or spawn.Area or "Unknown",
                        IncomeFormatted = incomeTxt,
                        IncomeVal = rawMoney, 
                        IconAsset = spawn.Icon or spawn.ImageAsset or "rbxassetid://6031075931"
                    })
                    HubState.ProcessedUids[uid] = true
                end
            end
            RefreshHUD()
        end
    end)
end

ScanServerForEggs()
