-- WORKSPACE SCANNER & SERVER BROADCAST DETECTOR
--------------------------------------------------------------------------------
local function ScanServerForEggs()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BillboardGui") then
            local textLabel = obj:FindFirstChildOfClass("TextLabel")
            if textLabel and (string.find(textLabel.Text, "/s") or string.find(textLabel.Text, "/sec")) then
                local model = obj.Parent
                if model and model:IsA("Model") then
                    local uid = model:GetAttribute("Uid") or model:GetAttribute("UID")
                    local slotKey = model:GetAttribute("SlotKey") or model:GetAttribute("FirstAreaSlotKey") or ""
                    
                    if not uid and model:FindFirstChild("Uid") then uid = model.Uid.Value end
                    if slotKey == "" and model:FindFirstChild("SlotKey") then slotKey = model.SlotKey.Value end
                    if not uid then uid = model.Name end 
                    
                    if uid and not HubState.ProcessedUids[uid] then
                        local rawMoney = ParseIncomeString(textLabel.Text)
                        table.insert(HubState.ActiveEggs, {
                            Uid = uid, SlotKey = slotKey, AssetCategory = model.Name, AreaId = "Map",
                            Rarity = "Discovered", IncomeFormatted = textLabel.Text, IncomeVal = rawMoney, IconAsset = "rbxassetid://6031075931"
                        })
                        HubState.ProcessedUids[uid] = true
                    end
                end
            end
        end
    end
    RefreshHUD()
end

-- Run scanner continuously
task.spawn(function()
    while task.wait(3) do
        ScanServerForEggs()
    end
end)

-- Listen for instant spawns
if RaritiesShownEvent then
    RaritiesShownEvent.OnClientEvent:Connect(function(payload)
        if payload and payload.RareSpawns then
            for _, spawn in ipairs(payload.RareSpawns) do
                local uid = spawn.Uid or spawn.UID
                if uid and not HubState.ProcessedUids[uid] then
                    local rawMoney = spawn.RawIncome or ParseIncomeString(spawn.IncomeRate)
                    table.insert(HubState.ActiveEggs, {
                        Uid = uid, SlotKey = spawn.SlotKey or spawn.FirstAreaSlotKey or "",
                        AssetCategory = spawn.AssetCategory or spawn.Name or "Rare Egg", AreaId = spawn.AreaId or spawn.Area or "Unknown",
                        Rarity = spawn.Rarity or "Secret", IncomeFormatted = spawn.IncomeRate or ("+$" .. tostring(rawMoney) .. "/s"),
                        IncomeVal = rawMoney, IconAsset = spawn.Icon or spawn.ImageAsset or "rbxassetid://6031075931"
                    })
                    HubState.ProcessedUids[uid] = true
                end
            end
            RefreshHUD()
        end
    end)
end

ScanServerForEggs()
