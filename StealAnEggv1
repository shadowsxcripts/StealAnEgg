local function ParseIncome(str)
    if not str then return 0 end
    if type(str) == "number" then return str end
    local clean = tostring(str):upper()
    local numPart = tonumber(string.match(clean, "[%d%.]+")) or 1
    local sfx = string.match(clean, "[KMBTQAISXPO]+$") or ""
    local mult = {K=1e3, M=1e6, B=1e9, T=1e12, QA=1e15, QI=1e18, SX=1e21, SP=1e24, OC=1e27, NO=1e30}
    return numPart * (mult[sfx] or 1)
end

-- Periodic Refresh & Stale Detection Hook
local function RefreshHUD()
    -- Purge stale or missing eggs from Workspace
    local validEggs = {}
    for _, egg in ipairs(HubState.ActiveEggs) do
        local isStillAlive = true
        if egg.InstanceRef and (not egg.InstanceRef.Parent or egg.InstanceRef.Parent == nil) then
            isStillAlive = false
        end
        if isStillAlive then
            table.insert(validEggs, egg)
        else
            HubState.ProcessedUids[egg.Uid] = nil
        end
    end
    HubState.ActiveEggs = validEggs

    table.sort(HubState.ActiveEggs, function(a, b)
        return (a.IncomeVal or 0) > (b.IncomeVal or 0)
    end)

    if #HubState.ActiveEggs > 0 then
        HubState.CurrentTarget = HubState.ActiveEggs[1]
        NameLabel.Text = HubState.CurrentTarget.AssetCategory
        MoneyLabel.Text = HubState.CurrentTarget.IncomeFormatted
        RarityBadge.Text = HubState.CurrentTarget.Rarity or "MYTHIC"
    else
        HubState.CurrentTarget = nil
        NameLabel.Text = "Scanning Server..."
        MoneyLabel.Text = "$0 / sec"
        RarityBadge.Text = "NONE"
    end
end

local function ExecuteWorkflow(target)
    if not target then return end
    print("[Shadow Hub]: Executing workflow for rarest egg:", target.AssetCategory)

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart

    root.CFrame = CFrame.new(0, 10, 0)
    task.wait(0.5)
    task.wait(0.8)
    root.CFrame = CFrame.new(150, 10, 150)
    task.wait(0.4)

    if AskCarryFunction then
        pcall(function()
            AskCarryFunction:InvokeServer({
                FirstAreaSlotKey = target.SlotKey or "Forest:Slot_001",
                Uid = target.Uid
            })
        end)
    end

    task.wait(1)
    local boss = Workspace:FindFirstChild("Boss") or Workspace:FindFirstChild("ForestBoss")
    if boss and boss.PrimaryPart then
        root.CFrame = boss.PrimaryPart.CFrame + Vector3.new(0, 8, 0)
    end
    task.wait(0.8)

    root.CFrame = CFrame.new(500, 10, 500)
    print("[Shadow Hub]: Delivered to Safe Zone!")

    -- Queue Rotation: remove collected egg and immediately refresh HUD
    for i, egg in ipairs(HubState.ActiveEggs) do
        if egg.Uid == target.Uid then
            table.remove(HubState.ActiveEggs, i)
            break
        end
    end

    RefreshHUD()
end

