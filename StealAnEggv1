    end
end)

local function ScanWorkspaceEggs()
    local searchRoots = {Workspace}
    local eggsFolder = Workspace:FindFirstChild("Eggs") or Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Eggs")
    if eggsFolder then table.insert(searchRoots, eggsFolder) end

    for _, root in ipairs(searchRoots) do
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("BasePart") then
                local uid = obj:GetAttribute("Uid") or obj:GetAttribute("UID") or obj:GetAttribute("ID")
                local assetCat = obj:GetAttribute("AssetCategory") or obj:GetAttribute("EggName") or obj:GetAttribute("DisplayName")
                local incomeRate = obj:GetAttribute("IncomeRate") or obj:GetAttribute("MoneyPerSecond") or obj:GetAttribute("Income")
                local iconVal = obj:GetAttribute("Icon") or obj:GetAttribute("ImageAsset")

                local isEggLike = assetCat ~= nil or obj.Name:lower():find("egg") or obj:GetAttribute("IsEgg") == true
                if isEggLike then
                    if not uid then
                        uid = obj.Name .. "_" .. tostring(math.floor(obj:GetPivot().Position.Magnitude))
                    end

                    local displayName = assetCat or obj:GetAttribute("Name") or obj.Name
                    if type(displayName) ~= "string" or displayName == "" or displayName:match("^[%w_]+$") and #displayName > 15 then
                        displayName = "Golden Mythic Egg"
                    end

                    local incomeStr = incomeRate or "+$50,000/s"
                    if type(incomeStr) == "number" then
                        incomeStr = "$ " .. tostring(incomeStr) .. " / sec"
                    end

                    local rawVal = ParseIncomeString(incomeStr)
                    local iconAsset = iconVal and ("rbxassetid://" .. tostring(iconVal)) or "rbxassetid://6031075931"

                    if not HubState.ProcessedUids[uid] then
                        table.insert(HubState.ActiveEggs, {
                            Uid = uid,
                            SlotKey = obj:GetAttribute("SlotKey") or obj:GetAttribute("FirstAreaSlotKey") or "Forest:Slot_001",
                            AssetCategory = displayName,
                            AreaId = obj:GetAttribute("AreaId") or "Forest",
                            IncomeFormatted = tostring(incomeStr),
                            IncomeVal = rawVal > 0 and rawVal or 25000,
                            IconAsset = iconAsset
                        })
                        HubState.ProcessedUids[uid] = true
                    end
                end
            end
        end
    end
    RefreshHUD()
end

