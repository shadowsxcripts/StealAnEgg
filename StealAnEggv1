local function RefreshHUD()
    table.sort(HubState.ActiveEggs, function(a, b)
        return (a.IncomeVal or 0) > (b.IncomeVal or 0)
    end)

    if #HubState.ActiveEggs > 0 then
        local top = HubState.ActiveEggs[1]
        HubState.CurrentTarget = top
        NameLabel.Text = top.AssetCategory or "Unknown Egg"
        MoneyLabel.Text = top.IncomeFormatted
        StatsLabel.Text = ("Stolen: %d | Queue: %d"):format(HubState.TotalStolen, #HubState.ActiveEggs)
        if top.IconAsset and top.IconAsset ~= "" then
            EggImage.Image = top.IconAsset
