-- FIXED SERVER SCANNER: Hook into RaritiesShownEvent + Deep Workspace Scan + Folder Descendants
if RaritiesShownEvent then
    RaritiesShownEvent.OnClientEvent:Connect(function(payload)
        if payload and (payload.RareSpawns or payload.Eggs) then
            local spawns = payload.RareSpawns or payload.Eggs
            for _, spawn in ipairs(spawns) do
                local uid = spawn.Uid or spawn.UID
                if uid and not HubState.ProcessedUids[uid] then
                    local name = spawn.AssetCategory or spawn.EggName or spawn.Name or "Mythic Egg"
                    local income = spawn.IncomeRate or spawn.MoneyPerSecond or "+$100,000,000/s"
                    local rarity = spawn.Rarity or "MYTHIC"
                    
                    table.insert(HubState.ActiveEggs, {
                        Uid = uid,
                        SlotKey = spawn.SlotKey or spawn.FirstAreaSlotKey or "Forest:Slot_001",
                        AssetCategory = name,
                        IncomeFormatted = tostring(income),
                        IncomeVal = ParseIncome(income),
                        AreaId = spawn.AreaId or "Forest",
                        Rarity = rarity
                    })
                    HubState.ProcessedUids[uid] = true
                end
            end
            RefreshHUD()
        end
    end)
end

-- Deep Workspace Folder & Attribute Scanner for all active server eggs
local function ScanServerEggs()
    local searchRoots = {Workspace}
    local eggsFolder = Workspace:FindFirstChild("Eggs") or Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Eggs")
    if eggsFolder then table.insert(searchRoots, eggsFolder) end

    for _, root in ipairs(searchRoots) do
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("BasePart") then
                local uid = obj:GetAttribute("Uid") or obj:GetAttribute("UID") or obj:GetAttribute("ID")
                local assetCat = obj:GetAttribute("AssetCategory") or obj:GetAttribute("EggName") or obj:GetAttribute("DisplayName")
                local incomeRate = obj:GetAttribute("IncomeRate") or obj:GetAttribute("MoneyPerSecond") or obj:GetAttribute("Income")
                local rarityAttr = obj:GetAttribute("Rarity") or "MYTHIC"

                local isEgg = assetCat ~= nil or obj.Name:lower():find("egg") or obj:GetAttribute("IsEgg") == true
                if isEgg then
                    local realUid = uid or (obj.Name .. "_" .. tostring(math.floor(obj:GetPivot().Position.Magnitude)))
                    if not HubState.ProcessedUids[realUid] then
                        local name = assetCat or obj.Name
                        local income = incomeRate or "+$50,000,000/s"
                        
                        table.insert(HubState.ActiveEggs, {
                            Uid = realUid,
                            SlotKey = obj:GetAttribute("SlotKey") or "Forest:Slot_001",
                            AssetCategory = name,
                            IncomeFormatted = tostring(income),
                            IncomeVal = ParseIncome(income),
                            AreaId = obj:GetAttribute("AreaId") or "Forest",
                            Rarity = tostring(rarityAttr)
                        })
                        HubState.ProcessedUids[realUid] = true
                    end
                end
            end
        end
    end
    RefreshHUD()
end

task.spawn(function()
    while true do
        pcall(ScanServerEggs)
