        while HubState.GodModeActive do
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if humanoid then humanoid.Health = humanoid.MaxHealth end
                end
            end)
            task.wait(0.1)
        end
    end)
end
