-- CARD UPDATE & SORTING LOGIC
--------------------------------------------------------------------------------
local function RefreshHUD()
    -- Sort active eggs STRICTLY by highest money per second
    table.sort(HubState.ActiveEggs, function(a, b)
        return (a.IncomeVal or 0) > (b.IncomeVal or 0)
    end)

    if #HubState.ActiveEggs > 0 then
        local top = HubState.ActiveEggs[1]
        HubState.CurrentTarget = top
        
        NameLabel.Text = top.AssetCategory or "Unknown Egg"
        RarityLabel.Text = "Rarity: " .. (top.Rarity or "Found")
        MoneyLabel.Text = top.IncomeFormatted or "+$0/s"
        EggImage.Image = top.IconAsset or "rbxassetid://6031075931"
    else
        HubState.CurrentTarget = nil
        NameLabel.Text = "No Eggs Available"
        RarityLabel.Text = "Rarity: N/A"
        MoneyLabel.Text = "$0 / sec"
        EggImage.Image = "rbxassetid://0"
    end
end

--------------------------------------------------------------------------------
-- CORE STEAL LOGIC & AUTO LOOP
--------------------------------------------------------------------------------
local function StealCurrentTarget()
    if not HubState.CurrentTarget then return end
    local target = HubState.CurrentTarget

    -- Server Steal Invocation
    if AskCarryFunction then
        pcall(function() AskCarryFunction:InvokeServer({FirstAreaSlotKey = target.SlotKey, Uid = target.Uid}) end)
    end

    -- Visual & Bypass Carry Event
    if CarryEvent then
        FireClientSignal(CarryEvent.OnClientEvent, {
            SpeedMultiplier = 0.95,
            Uid = target.Uid,
            GuardDisabled = true,
            RunBackWakeDelayRequired = false,
            AssetCategory = target.AssetCategory,
            IsCarrying = true,
            AreaId = target.AreaId
        })
    end

    -- Remove stolen egg from queue
    for i, egg in ipairs(HubState.ActiveEggs) do
        if egg.Uid == target.Uid then
            table.remove(HubState.ActiveEggs, i)
            break
        end
    end

    -- Teleport back to safe zone immediately
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and HubState.BaseCFrame then
        task.wait(0.2)
        LocalPlayer.Character.HumanoidRootPart.CFrame = HubState.BaseCFrame
    end

    RefreshHUD()
end

-- Toggle Button Click Event
