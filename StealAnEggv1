local function GetHRP()
    local Char = LocalPlayer.Character
    return Char and Char:FindFirstChild("HumanoidRootPart")
end

local function GetSafeZoneCFrame()
    local Plots = Workspace:FindFirstChild("Bases") or Workspace:FindFirstChild("Plots")
    if Plots then
        for _, plot in pairs(Plots:GetChildren()) do
            local owner = plot:FindFirstChild("Owner") or plot:GetAttribute("Owner")
            if owner == LocalPlayer.Name or owner == LocalPlayer.UserId then
                return plot:GetPivot() + Vector3.new(0, 4, 0)
            end
        end
    end
    
    local safeZone = Workspace:FindFirstChild("SafeZone", true) or Workspace:FindFirstChild("SpawnLocation", true)
    if safeZone and safeZone:IsA("PVInstance") then
        return safeZone:GetPivot() + Vector3.new(0, 4, 0)
    end

    local hrp = GetHRP()
    return hrp and hrp.CFrame or CFrame.new(0, 50, 0)
end

local function SmoothMoveTo(targetCFrame)
    local hrp = GetHRP()
    if not hrp then return end
    
    local distance = (targetCFrame.Position - hrp.Position).Magnitude
    local travelTime = math.clamp(distance / 50, 0.15, 0.8)
    
    local tween = TweenService:Create(hrp, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {
        CFrame = targetCFrame + Vector3.new(0, 3, 0)
    })
    tween:Play()
    tween.Completed:Wait()
end

local function ExecuteRarestEggHunter()
    local hrp = GetHRP()
    if not hrp or CurrentTarget.Uid == "" then return end

    local targetInst = CurrentTarget.Instance
    if not targetInst and CurrentTarget.SlotKey ~= "" then
        targetInst = Workspace:FindFirstChild(CurrentTarget.SlotKey, true)
    end
    if not targetInst then
        targetInst = Workspace:FindFirstChild(CurrentTarget.Uid, true)
    end

    if targetInst and targetInst:IsA("PVInstance") then
        SmoothMoveTo(targetInst:GetPivot())
    else
        hrp.CFrame = hrp.CFrame + Vector3.new(0, 2, 0)
    end
    task.wait(0.15)

    -- Dynamic Remote Spy Assembly for AskFieldEggCarry
    local askPayload = CapturedAskTemplate and table.clone(CapturedAskTemplate) or {
        FirstAreaSlotKey = CurrentTarget.SlotKey ~= "" and CurrentTarget.SlotKey or "Forest:Slot_002",
        Uid = CurrentTarget.Uid
    }
    askPayload.FirstAreaSlotKey = CurrentTarget.SlotKey ~= "" and CurrentTarget.SlotKey or askPayload.FirstAreaSlotKey
    askPayload.Uid = CurrentTarget.Uid

    pcall(function()
        if AskCarryFunction then
            AskCarryFunction:InvokeServer(askPayload)
        end
    end)

    -- Dynamic Remote Spy Assembly for FieldEggCarry
    local carryPayload = CapturedCarryTemplate and table.clone(CapturedCarryTemplate) or {
        SpeedMultiplier = 0.95044861554791,
        Uid = CurrentTarget.Uid,
        GuardDisabled = false,
        RunBackWakeDelayRequired = true,
        AssetCategory = CurrentTarget.Name,
        IsCarrying = true,
        AreaId = CurrentTarget.AreaId
    }
    carryPayload.Uid = CurrentTarget.Uid
    carryPayload.AssetCategory = CurrentTarget.Name
    carryPayload.AreaId = CurrentTarget.AreaId
    carryPayload.IsCarrying = true

    if typeof(firesignal) == "function" and CarryEvent then
        pcall(function()
            firesignal(CarryEvent.OnClientEvent, carryPayload)
        end)
    end
    task.wait(0.2)

    SmoothMoveTo(GetSafeZoneCFrame())

    ClaimedEggs[CurrentTarget.Uid] = true
    EvaluateRarestEgg()
    RefreshUI()
end

