local function ExecuteAdvancedSteal(target)
    if not target then return end
    FooterLabel.Text = "Stealing: " .. target.AssetCategory
    RandomizedLatencyWait(100, 250)

    if AskCarryFunction then
        pcall(function()
            AskCarryFunction:InvokeServer({
                FirstAreaSlotKey = target.SlotKey or "Forest:Slot_001",
                Uid = target.Uid
            })
        end)
    end

    RandomizedLatencyWait(50, 120)

    if CarryEvent then
        FireClientSignal(CarryEvent.OnClientEvent, {
            SpeedMultiplier = 0.9504486,
            Uid = target.Uid,
            GuardDisabled = true,
            RunBackWakeDelayRequired = true,
            AssetCategory = target.AssetCategory,
            IsCarrying = true,
            AreaId = target.AreaId or "Forest"
        })
    end

    HubState.TotalStolen = HubState.TotalStolen + 1

    for i, egg in ipairs(HubState.ActiveEggs) do
        if egg.Uid == target.Uid then
            table.remove(HubState.ActiveEggs, i)
            break
        end
    end

    task.wait(0.1)
    if LocalPlayer.Character and HubState.BaseCFrame then
        HumanoidJitterMove(HubState.BaseCFrame)
    end

    RefreshHUD()
end

