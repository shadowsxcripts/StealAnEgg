local function FindRemote(className, targetName)
    local found = nil
    pcall(function()
        for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
            if descendant:IsA(className) and (descendant.Name == targetName or descendant.Name:find(targetName)) then
                found = descendant
                break
            end
        end
    end)
    return found
end

