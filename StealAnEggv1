--------------------------------------------------------------------------------
-- SAFE TELEPORT & AUTOMATION LOOP
--------------------------------------------------------------------------------

local function FindPlayerBaseCFrame()
    local Plots = Workspace:FindFirstChild("Bases") or Workspace:FindFirstChild("Plots")
    if Plots then
        for _, plot in pairs(Plots:GetChildren()) do
            local owner = plot:FindFirstChild("Owner") or plot:GetAttribute("Owner")
            if owner == LocalPlayer.Name or owner == LocalPlayer.UserId then
                return plot:GetPivot() + Vector3.new(0, 4, 0)
            end
        end
    end
    
    local safeZone = Workspace:FindFirstChild("SafeZone", true) or Workspace:FindFirstChild("SpawnLocation", true)
    if safeZone and safeZone:IsA("PVInstance") then
        return safeZone:GetPivot() + Vector3.new(0, 4, 0)
    end

    local hrp = GetHRP()
    return hrp and hrp.CFrame or CFrame.new(0, 50, 0)
end

local function ExecuteSteal()
    local hrp = GetHRP()
    if not hrp or CurrentTarget.Uid == "" then return end

    -- 1. Locate and Teleport to Egg Model
    local targetInstance = nil
    if CurrentTarget.SlotKey ~= "" then
        targetInstance = Workspace:FindFirstChild(CurrentTarget.SlotKey, true)
    end
    if not targetInstance then
        targetInstance = Workspace:FindFirstChild(CurrentTarget.Uid, true)
    end

    if targetInstance and targetInstance:IsA("PVInstance") then
        hrp.CFrame = targetInstance:GetPivot() + Vector3.new(0, 3, 0)
    end
    task.wait(0.3)

    -- 2. Remote Handshake (Safely Wrapped)
    pcall(function()
        if AskCarryFunction then
            AskCarryFunction:InvokeServer({
                FirstAreaSlotKey = CurrentTarget.SlotKey,
                Uid = CurrentTarget.Uid
            })
        end
    end)

    if typeof(firesignal) == "function" and CarryEvent then
        pcall(function()
            firesignal(CarryEvent.OnClientEvent, {
                SpeedMultiplier = 1.0,
                Uid = CurrentTarget.Uid,
                GuardDisabled = false,
                RunBackWakeDelayRequired = true,
                AssetCategory = CurrentTarget.Name,
                IsCarrying = true,
                AreaId = CurrentTarget.AreaId
            })
        end)
    end
    task.wait(0.3)

    -- 3. Return to Safe Base
    local baseCFrame = FindPlayerBaseCFrame()
    if hrp then
        hrp.CFrame = baseCFrame
    end

    -- 4. Mark Collected & Instantly Auto-Select Next Best Egg
    ClaimedEggs[CurrentTarget.Uid] = true
    EvaluateQueue()
    RefreshUI()
end

ActionBtn.MouseButton1Click:Connect(function()
    AutoStealEnabled = not AutoStealEnabled

    if AutoStealEnabled then
        ActionBtn.Text = "AUTO GET EGG: ON"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(40, 190, 90)

        AutoThread = task.spawn(function()
            while AutoStealEnabled do
                if CurrentTarget.Uid ~= "" and not ClaimedEggs[CurrentTarget.Uid] then
                    ExecuteSteal()
                else
                    EvaluateQueue()
                    RefreshUI()
                end
                task.wait(2.5)
            end
        end)
    else
        ActionBtn.Text = "AUTO GET EGG: OFF"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(120, 80, 255)

        if AutoThread then
            task.cancel(AutoThread)
            AutoThread = nil
        end
    end
end)
