local function ParseIncome(str)
    if not str then return 0 end
    if type(str) == "number" then return str end
    local clean = tostring(str):upper()
    local numPart = tonumber(string.match(clean, "[%d%.]+")) or 1
    local sfx = string.match(clean, "[KMBTQAISXPO]+$") or ""
    local mult = {K=1e3, M=1e6, B=1e9, T=1e12, QA=1e15, QI=1e18, SX=1e21, SP=1e24, OC=1e27, NO=1e30}
    return numPart * (mult[sfx] or 1)
end

local function RefreshHUD()
    table.sort(HubState.ActiveEggs, function(a, b)
        return (a.IncomeVal or 0) > (b.IncomeVal or 0)
    end)

    if #HubState.ActiveEggs > 0 then
        HubState.CurrentTarget = HubState.ActiveEggs[1]
        NameLabel.Text = HubState.CurrentTarget.AssetCategory
        MoneyLabel.Text = HubState.CurrentTarget.IncomeFormatted
        RarityBadge.Text = HubState.CurrentTarget.Rarity or "MYTHIC"
    else
        HubState.CurrentTarget = nil
        NameLabel.Text = "No Eggs Found"
        MoneyLabel.Text = "$0 / sec"
        RarityBadge.Text = "NONE"
    end
end

-- Ultra-Safe Workflow Execution with Pcall
local function ExecuteWorkflow(target)
    if not target then return end
    Log("Executing workflow for target: " .. tostring(target.AssetCategory))

    local areaData = SlotKeyRegistry[target.AreaId] or SlotKeyRegistry["Forest"]
    local verifiedSlotKey = areaData.ValidSlots[1]
    for _, slot in ipairs(areaData.ValidSlots) do
        if slot == target.SlotKey then
            verifiedSlotKey = slot
            break
        end
    end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then 
        Log("Error: Character RootPart not found!")
        return 
    end
    local root = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if humanoid then humanoid.Health = humanoid.MaxHealth end

    pcall(function()
        root.CFrame = areaData.CenterCFrame + Vector3.new(0, 15, 0)
    end)
    task.wait(0.4)

    pcall(function()
        if target.InstanceRef and target.InstanceRef.PrimaryPart then
            root.CFrame = target.InstanceRef.PrimaryPart.CFrame + Vector3.new(0, 4, 0)
        else
            root.CFrame = areaData.CenterCFrame + Vector3.new(10, 10, 10)
        end
    end)
    task.wait(0.3)

    if AskCarryFunction then
        local success, err = pcall(function()
            AskCarryFunction:InvokeServer({
                FirstAreaSlotKey = verifiedSlotKey,
                Uid = target.Uid
            })
        end)
        if success then
            Log("Successfully invoked AskFieldEggCarry!")
        else
            Log("InvokeServer failed: " .. tostring(err))
        end
    else
        Log("Warning: AskCarryFunction is nil. Skipping remote invoke.")
    end

    task.wait(0.6)
    pcall(function()
        root.CFrame = areaData.SafeZoneCFrame
    end)

    for i, egg in ipairs(HubState.ActiveEggs) do
        if egg.Uid == target.Uid then
            table.remove(HubState.ActiveEggs, i)
            break
        end
    end

    RefreshHUD()
end

