-- Background Periodic Refresh Worker Loop (Runs every 1s to prevent stale detection)
task.spawn(function()
    while true do
        pcall(function()
            if typeof(getinstances) == "function" then
                for _, obj in ipairs(getinstances()) do
                    if obj and obj.Parent then
                        local uid = obj:GetAttribute("Uid") or obj:GetAttribute("UID")
                        local assetCat = obj:GetAttribute("AssetCategory") or obj:GetAttribute("EggName")
                        local income = obj:GetAttribute("IncomeRate") or obj:GetAttribute("MoneyPerSecond")

                        if assetCat or (obj.Name:lower():find("egg") and obj:IsA("Model")) then
                            local realUid = uid or (obj.Name .. "_" .. math.floor(obj:GetPivot().Position.Magnitude))
                            if not HubState.ProcessedUids[realUid] then
                                local name = assetCat or obj.Name
                                local incStr = income or "+$50,000,000/s"
                                table.insert(HubState.ActiveEggs, {
                                    Uid = realUid,
                                    SlotKey = obj:GetAttribute("SlotKey") or "Forest:Slot_001",
                                    AssetCategory = tostring(name),
                                    IncomeFormatted = tostring(incStr),
                                    IncomeVal = ParseIncome(incStr),
                                    AreaId = obj:GetAttribute("AreaId") or "Forest",
                                    Rarity = obj:GetAttribute("Rarity") or "MYTHIC",
                                    InstanceRef = obj
                                })
                                HubState.ProcessedUids[realUid] = true
                            end
                        end
                    end
                end
            end
        end)

        RefreshHUD()
        task.wait(HubState.ScanInterval)
    end
end)

